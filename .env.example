TZ=Europe/Berlin

# Optional: stabiler Flask-Session-Key. Leer: automatisch in config/.secret_key gespeichert.
# Erzeugen mit: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Zugangsdaten für den Admin-Bereich
ADMIN_USER=cremer
ADMIN_PASSWORD=changeme
# Optional: Wenn statt Klartext das gehashte Passwort genutzt wird
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...
# Optional: MFA-Secret für den Admin-Account
# ADMIN_MFA_SECRET=BASE32SECRET

# SMTP-Konfiguration für das Kontaktformular
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=change-me
SMTP_SENDER=kontakt@example.com
SMTP_RECIPIENTS=vorstand@example.com,support@example.com
SMTP_USE_TLS=true
